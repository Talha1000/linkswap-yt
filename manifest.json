{
  "manifest_version": 3,
  "name": "LinkSwap YT — YouTube Studio Affiliate & Sponsor Link Replacer",
  "version": "1.0.0",
  "description": "Tactile luxury workspace to find and batch-replace affiliate and sponsor links across YouTube video descriptions with visual git diffs.",
  "permissions": [
    "identity",
    "storage",
    "sidePanel",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://studio.youtube.com/*",
    "https://api.gumroad.com/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/panel/index.html"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "LinkSwap YT",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/youtube.force-ssl",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  }
}
